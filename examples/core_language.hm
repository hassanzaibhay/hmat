# HMAT Core Language — Phase 2 milestone.
# Compile: hmatc core_language.hm

# ── Variables ─────────────────────────────────────────────────────

name      = "HMAT"
pi        = 3.14159
let version: int = 2     # 'let' is optional but clear
mut count = 0
count += 1

# ── Functions ─────────────────────────────────────────────────────

fn greet(name: str) -> str:
    "Hello, {name}! Welcome to HMAT."

fn add(a: int, b: int) -> int: a + b      # single-line

fn divide(a: float, b: float) -> float or Fail:
    fail "division by zero" if b == 0.0
    a / b

# ── Data Shapes ───────────────────────────────────────────────────

shape Point:
    x: float
    y: float

    fn new(x: float, y: float) -> Point:
        Point { x, y }

    fn distance(self, other: Point) -> float:
        dx = self.x - other.x
        dy = self.y - other.y
        (dx^2 + dy^2).sqrt()

    fn display(self) -> str:
        "Point({self.x}, {self.y})"

# ── Sum Types ─────────────────────────────────────────────────────

type Direction = North | South | East | West

type Shape:
    Circle(radius: float)
    Rect(width: float, height: float)
    Triangle(base: float, height: float)

fn area(s: Shape) -> float:
    on s:
        Circle(r)      => 3.14159 * r^2
        Rect(w, h)     => w * h
        Triangle(b, h) => 0.5 * b * h

# ── Generics ──────────────────────────────────────────────────────

fn max[T: Comparable](a: T, b: T) -> T:
    a if a > b else b

fn first[T](list: [T]) -> T or nil:
    nil if list.is_empty() else list[0]

# ── Error Handling ────────────────────────────────────────────────

fn demo_errors():
    result = divide(10, 0) or 0.0
    print("divide(10,0) or 0.0 = {result}")

    on divide(10, 2):
        float as n => print("10 / 2 = {n}")
        Fail  as e => print("error: {e}")

    val = first([]) or -1
    print("first([]) or -1 = {val}")

# ── Collections ───────────────────────────────────────────────────

fn demo_collections():
    nums   = [1..10]
    evens  = [x for x in nums if x % 2 == 0]
    total  = evens.map(x => x * 2).sum()
    print("sum of doubled evens: {total}")

    scores = { "alice": 100, "bob": 95 }
    top    = scores.get("alice") or 0
    print("alice: {top}")

# ── Pattern Matching ──────────────────────────────────────────────

fn demo_patterns():
    score = 95
    grade = on score:
        n if n >= 90 => "A"
        n if n >= 80 => "B"
        n if n >= 70 => "C"
        _            => "F"
    print("grade: {grade}")

    on Rect(4.0, 5.0):
        Circle(r)      => print("circle r={r}")
        Rect(w, h)     => print("rect area={w*h}")
        Triangle(b, h) => print("triangle")

# ── Main ──────────────────────────────────────────────────────────

fn main():
    print("=== HMAT Core Language ===")
    print(greet("developer"))
    print("add(3,4) = {add(3, 4)}")
    print("max(3,7) = {max(3, 7)}")
    let p1 = Point.new(0.0, 0.0)
    let p2 = Point.new(3.0, 4.0)
    print(p2.display())
    print("distance: {p1.distance(p2)}")
    demo_errors()
    demo_collections()
    demo_patterns()
    print("=== Done ===")
