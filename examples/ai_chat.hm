# HMAT AI Chat — Phase 3 milestone example.
# Demonstrates HMAT's AI-native identity.
# Compile: hmatc ai_chat.hm
# Run:     ANTHROPIC_API_KEY=your_key ./ai_chat

from hmat.ai import Msg

# AI is a first-class language primitive
ai assistant = model("anthropic/claude-3-5-sonnet"):
    temperature: 0.7
    max_tokens: 1024
    system: "You are a helpful assistant. Be concise."

# Simple ask
async fn simple_demo():
    reply = assistant.ask("What is HMAT in one sentence?") or "unavailable"
    print("AI: {reply}")

# Multi-turn conversation
async fn conversation_demo():
    let history: [Msg] = []

    let questions = [
        "What is HMAT?",
        "What makes it AI-native?",
        "Give me one code example."
    ]

    for q in questions:
        print("You: {q}")
        history.push(Msg { role: "user", content: q })

        on assistant.chat(history):
            str as reply:
                print("AI: {reply}")
                history.push(Msg { role: "assistant", content: reply })
            Fail as e:
                on e:
                    AiError.Timeout     => print("timed out, skipping")
                    AiError.RateLimited => break
                    _                   => print("error: {e}")

# Structured extraction
shape CodeReview:
    has_bugs: bool
    suggestions: [str]
    quality: int    # 1-10

async fn review_demo():
    let sample_code = "fn main(): print(\"hello\")"

    on assistant.extract[CodeReview](sample_code):
        CodeReview as r:
            print("bugs: {r.has_bugs}")
            print("quality: {r.quality}/10")
            for s in r.suggestions:
                print("  - {s}")
        Fail as e => print("review failed: {e}")

# Flow pipeline
ai fast = model("anthropic/claude-haiku-4-5"):
    temperature: 0.0

flow analyze_sentiment:
    input => fast.classify(labels: ["positive", "negative", "neutral"]) => output

async fn pipeline_demo():
    let feedbacks = [
        "HMAT is incredible!",
        "Found a compiler bug.",
        "Decent, needs more docs."
    ]

    for fb in feedbacks:
        let label = analyze_sentiment.run(fb) or "unknown"
        print("{fb} => {label}")

# Parallel AI calls
async fn parallel_demo():
    from hmat.async import join

    let (py, rs, hm) = join(
        fast.ask("Describe Python in one word."),
        fast.ask("Describe Rust in one word."),
        fast.ask("Describe HMAT in one word.")
    ) or ("?", "?", "?")

    print("Python: {py}")
    print("Rust:   {rs}")
    print("HMAT:   {hm}")

async fn main():
    print("=== HMAT AI Demo ===")
    await simple_demo()
    await conversation_demo()
    await review_demo()
    await pipeline_demo()
    await parallel_demo()
    print("=== Done ===")
