# ============================================================
# HMAT Project .gitignore
# Rule: Claude-related files, prompts, runner scripts = local only.
# ============================================================

# --- Claude brain and prompts (NEVER push) ---
CLAUDE.md
prompts/

# --- Runner scripts (local workflow tooling, never push) ---
Makefile
run.py
run.ps1

# --- Local session/report scratch files ---
clean/
security/
qa/
docs/bugs/
*.session.md

# --- Pipeline output files (local only) ---
output
output_*

# ============================================================
# Rust build artifacts
# ============================================================
target/
**/.cargo/

# ============================================================
# Test and coverage artifacts
# ============================================================
coverage/
*.profraw
*.profdata
lcov.info
tarpaulin-report.html
fuzz/

# ============================================================
# Generated binaries and LLVM artifacts
# ============================================================
*.hm.out
examples/*.bin
/hello
/output
*.ll
*.bc
*.s
*.o
a.out

# ============================================================
# hmatc outputs — .c is intermediate, .exe is the final binary
# (hmatc itself is a Rust crate, so it has no hand-written .c sources)
# ============================================================
*.exe
*.c

# ============================================================
# Editor and OS artifacts
# ============================================================
.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Secrets — never commit
# ============================================================
.env
.env.local
.env.*
!.env.example
*.key
*.pem
*.secret

# ============================================================
# Tooling caches
# ============================================================
node_modules/
dist/
.hpkg/
hpkg-lock.toml
.hmat-cache/

# ============================================================
# Agents
# ============================================================
agents/
